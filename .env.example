# YouTube API Key (from Google Cloud Console)
YOUTUBE_API_KEY=your_youtube_api_key

# LLM Configuration (DeepSeek or OpenAI compatible)
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Notification Type: email, feishu, or both
NOTIFICATION_TYPE=email

# Email Configuration (required if NOTIFICATION_TYPE is email or both)
SMTP_SERVER=smtp.qq.com
SMTP_PORT=587
SENDER_EMAIL=your_email@qq.com
SENDER_PASSWORD=your_smtp_authorization_code
RECEIVER_EMAIL=receiver@example.com

# Feishu Configuration (required if NOTIFICATION_TYPE is feishu or both)
# Get webhook URL from: Feishu Group -> Settings -> Group Bot -> Add Bot -> Custom Bot
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
